<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tema sem barra de título e sem fundo branco: o jogo cobre a tela toda. -->
    <style name="Theme.Deadzone" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/dz_bg</item>
        <item name="android:colorBackground">@color/dz_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

</resources>
